[{"plan":{"file":"20260908-115633.jpg","scene":"湖畔石碑与芦苇景观","intent":"在保持自然影调的前提下，温和提亮暗部石碑与木栈道，同时严格控制蓝色通道饱和度，防止天空与湖面出现色彩溢出与高光剪切。","steps":["微调曝光与对比度，保持画面整体明暗基调的自然过渡。","温和提升阴影（shadows）以恢复石碑和木栈道的暗部细节，避免过度提亮产生HDR光晕。","适度降低高光（highlights）以保护天空云层细节，防止高光区域过载。","微调色温，赋予画面极其轻微的暖意，使芦苇呈现自然的金色。","在HSL中对蓝色进行轻微降饱和与亮度微调，防止天空和湖水蓝色过载剪切，保持色彩的真实与通透。"],"cautions":["由于无空间遮罩，提升阴影会同时影响树木阴影，需控制幅度以防画面变灰。","蓝色通道调整会同时作用于天空与湖面，必须采用负向饱和度微调以避免单通道溢出。"],"basic":{"exposure":0.02,"contrast":0.02,"shadows":0.08,"highlights":-0.08,"temperature":0.005,"tint":-0.002,"saturation":-0.02},"curve_y":[0,33.0,65.0,97.0,128.0,159.0,191.0,223.0,255],"hsl":[{"band":"orange","half_width":25.0,"hue_shift":0.0,"saturation_percent":2.0,"lightness_points":0.0},{"band":"yellow","half_width":30.0,"hue_shift":1.0,"saturation_percent":3.0,"lightness_points":1.0},{"band":"green","half_width":40.0,"hue_shift":0.0,"saturation_percent":1.0,"lightness_points":0.0},{"band":"blue","half_width":35.0,"hue_shift":0.0,"saturation_percent":-5.0,"lightness_points":-1.0}],"color_balance":{"shadows":[0.0,0.0,0.0],"midtones":[0.0,0.0,0.0],"highlights":[0.0,0.0,0.0]}},"input":[[0,0,0],[255,255,255],[128,128,128],[255,0,0],[0,255,0],[0,0,255],[255,1,10],[255,10,1],[72,190,244],[233,26,121],[139,102,156],[52,147,54],[22,36,200],[104,110,161],[85,163,153],[27,234,55],[1,122,36],[43,10,41],[77,27,25],[7,182,233],[73,97,65],[142,113,89],[81,175,50],[253,125,164],[157,159,118],[95,119,210],[139,132,201],[165,204,84],[251,14,158],[72,123,54],[226,119,219],[120,253,131],[8,245,58],[53,49,193],[153,168,183],[42,79,117],[92,190,169],[72,121,50],[130,190,28],[189,44,216],[207,109,115],[123,148,28],[17,97,179],[9,199,139],[14,115,200],[44,20,246],[248,48,179],[71,253,74],[33,201,170],[18,110,143],[252,139,62],[189,106,206],[185,70,171],[202,240,214],[166,98,250],[10,66,41],[63,200,40],[220,67,50],[186,228,18],[85,59,94],[107,180,219],[128,232,65],[158,197,157],[253,18,112],[221,242,231],[141,128,211],[219,60,189],[168,246,63],[10,84,78],[193,174,19],